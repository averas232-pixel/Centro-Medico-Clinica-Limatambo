<Window x:Class="Centro_Medico_UI.NuevoPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo paciente" Width="420" Height="560" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Nuevo paciente" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Registra al paciente para poder agendarle una cita." Margin="0,6,0,20" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <TextBlock Text="DNI" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="DniText" Padding="8,6" MaxLength="8" Margin="0,0,0,12"/>

            <TextBlock Text="Nombres" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="NombresText" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Apellidos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="ApellidosText" Padding="8,6" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fecha de nacimiento" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FechaNacPicker" Padding="6,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sexo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SexoCombo" Padding="8,6">
                        <ComboBoxItem Content="M"/>
                        <ComboBoxItem Content="F"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Teléfono" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TelefonoText" Padding="8,6" MaxLength="9" Margin="0,0,0,12"/>

            <TextBlock Text="Dirección" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="DireccionText" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Email (opcional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailText" Padding="8,6" Margin="0,0,0,8"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,14" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Guardar paciente" Style="{StaticResource PrimaryButton}" Click="Guardar_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>