<Window x:Class="Centro_Medico_UI.Views.NuevaCitaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva cita" Width="560" Height="650" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Nueva cita" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Completa todos los campos para programar la atención." Margin="0,8,0,20" TextWrapping="Wrap"/>
            <StackPanel x:Name="Formulario" IsEnabled="False">
                <Label Content="_Paciente" Target="{Binding ElementName=PacienteCombo}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="PacienteCombo" DisplayMemberPath="NombreCompleto" IsTextSearchEnabled="True" MinHeight="36"/>
                    <Button Grid.Column="2" Content="+ Nuevo" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="NuevoPaciente_Click"/>
                </Grid>
                <Label Content="_Médico" Target="{Binding ElementName=MedicoCombo}" Margin="0,10,0,0"/>
                <ComboBox x:Name="MedicoCombo" DisplayMemberPath="NombreCompleto" IsTextSearchEnabled="True" MinHeight="36"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="_Fecha" Target="{Binding ElementName=FechaPicker}"/>
                        <DatePicker x:Name="FechaPicker"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="_Hora (24 h, ejemplo: 14:30)" Target="{Binding ElementName=HoraText}"/>
                        <TextBox x:Name="HoraText" MinHeight="34" Padding="8,4" MaxLength="5"/>
                    </StackPanel>
                </Grid>
                <Label Content="M_otivo" Target="{Binding ElementName=MotivoText}" Margin="0,10,0,0"/>
                <TextBox x:Name="MotivoText" Height="85" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/>
            </StackPanel>
            <TextBlock x:Name="EstadoText" Text="Cargando pacientes y médicos…" TextWrapping="Wrap" Margin="0,16,0,12" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelarButton" Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="GuardarButton" Content="Guardar cita" IsEnabled="False" Click="Guardar_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>