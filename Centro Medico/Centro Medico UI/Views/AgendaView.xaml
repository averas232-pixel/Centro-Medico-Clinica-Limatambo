<UserControl x:Class="Centro_Medico_UI.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="/Assets/Images/logo_limatambo.png" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CLINICA LIMATAMBO" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18"/>
                        <TextBlock Text="Sistema de Gestión" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnNuevaCita" Click="NuevaCita_Click" Content="+ NUEVA CITA"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        AutomationProperties.Name="Nueva cita"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Height="140" ClipToBounds="True">
            <Rectangle>
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/Assets/Images/banner_clinica_LimaTambo.jpg"
                                Stretch="UniformToFill"
                                AlignmentX="Center"
                                AlignmentY="Center"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="#88000000"/>
            <StackPanel VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock Text="CLINICA LIMATAMBO" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Agenda de Citas" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Gestiona y visualiza las citas del día" FontSize="12"
                           Foreground="#E0E0E0" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Fecha:" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding FechaSeleccionada}" Width="150" VerticalAlignment="Center"/>
                    <Button Content="ACTUALIZAR" Command="{Binding CargarAgendaCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid ItemsSource="{Binding Citas}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HORA" Binding="{Binding FechaHora, StringFormat={}{0:HH:mm}}" Width="80"/>
                        <DataGridTextColumn Header="PACIENTE ID" Binding="{Binding PacienteID}" Width="120"/>
                        <DataGridTextColumn Header="MÉDICO ID" Binding="{Binding MedicoID}" Width="120"/>
                        <DataGridTextColumn Header="MOTIVO" Binding="{Binding Motivo}" Width="*"/>
                        <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>