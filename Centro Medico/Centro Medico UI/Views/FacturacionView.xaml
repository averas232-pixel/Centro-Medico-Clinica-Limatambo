<UserControl x:Class="Centro_Medico_UI.Views.FacturacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Facturación" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

        <!-- ===== Tarjetas resumen ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="TOTAL FACTURADO" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalFacturado, StringFormat=S/ {0:N2}}" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="BOLETAS PAGADAS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CantidadPagadas}" FontSize="26"
                               FontWeight="Bold" Foreground="#1E8E3E" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="ANULADAS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CantidadAnuladas}" FontSize="26"
                               FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Lista + detalle lado a lado ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de boletas -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Facturas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="FacturaItem_Click"
                                        HorizontalContentAlignment="Stretch" BorderThickness="0"
                                        Background="Transparent" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="fondo" Background="Transparent" Padding="16,14"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="fondo" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="6" Padding="8,4" Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding Estado, Converter={StaticResource EstadoBgConverter}}">
                                            <TextBlock Text="{Binding Estado}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding Estado, Converter={StaticResource EstadoFgConverter}}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding NombrePaciente}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0">
                                                <Run Text="{Binding Serie}"/><Run Text="-"/><Run Text="{Binding Correlativo}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=S/ {0:N2}}"
                                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Detalle tipo recibo -->
            <Grid Grid.Column="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding SinSeleccionVisible}">
                    <TextBlock Text="🧾" FontSize="42" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="Selecciona una boleta para ver el detalle" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource CardBorder}" Visibility="{Binding DetalleVisible}">
                    <StackPanel>
                        <TextBlock Text="CLÍNICA LIMATAMBO" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Boleta de Venta Electrónica" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,10">
                            <StackPanel>
                                <TextBlock FontSize="12" Margin="0,2,0,0">
                                    <Run Text="Serie/N°: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding FacturaSeleccionada.Serie}" FontWeight="Bold"/>
                                    <Run Text="-"/>
                                    <Run Text="{Binding FacturaSeleccionada.Correlativo}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,4,0,0">
                                    <Run Text="Paciente: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding FacturaSeleccionada.NombrePaciente}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,4,0,0">
                                    <Run Text="Método de pago: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding FacturaSeleccionada.MetodoPago}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FacturaSeleccionada.Detalles}" Margin="0,12,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Descripcion}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=S/ {0:N2}}" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Subtotal" FontSize="12" HorizontalAlignment="Left" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FacturaSeleccionada.Subtotal, StringFormat=S/ {0:N2}}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="IGV (18%)" FontSize="12" HorizontalAlignment="Left" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FacturaSeleccionada.IGV, StringFormat=S/ {0:N2}}" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="TOTAL" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding FacturaSeleccionada.Total, StringFormat=S/ {0:N2}}" FontSize="18"
                                               FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>