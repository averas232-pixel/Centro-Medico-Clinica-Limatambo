<UserControl x:Class="Centro_Medico_UI.Views.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Historial Clínico" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

        <!-- ===== Buscador con sugerencias en vivo ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Buscar paciente por nombre o DNI" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,6"/>
                    <Grid>
                        <TextBox x:Name="CajaBusqueda" Text="{Binding BusquedaPaciente, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="34,10" FontSize="14"/>
                        <TextBlock Text="🔍" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Opacity="0.5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Panel de sugerencias flotante -->
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,68,0,0" MaxHeight="260"
                    Visibility="{Binding SugerenciasVisibles}" Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="14" ShadowDepth="3"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sugerencias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SeleccionarPacienteCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="fondo" Background="Transparent" Padding="14,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="fondo" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding NombreCompleto}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DNI, StringFormat=  ·  DNI {0}}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Ficha del paciente seleccionado ===== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,16,0,20"
                Visibility="{Binding FichaVisible}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PrimaryLightBrush}" CornerRadius="24"
                        Width="48" Height="48" Margin="0,0,16,0">
                    <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PacienteSeleccionado.NombreCompleto}" FontWeight="Bold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding PacienteSeleccionado.DNI, StringFormat=DNI: {0}}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding EdadPaciente, StringFormat={}{0} años}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding PacienteSeleccionado.Telefono}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource PrimaryLightBrush}" CornerRadius="8"
                        Padding="16,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Historiales.Count}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" consultas" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="6,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Línea de tiempo / estados vacíos ===== -->
        <Grid Grid.Row="3">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SinSeleccionVisible}">
                <TextBlock Text="🔎" FontSize="42" HorizontalAlignment="Center" Opacity="0.4"/>
                <TextBlock Text="Busca un paciente por nombre o DNI para ver su historial" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SinHistorialVisible}">
                <TextBlock Text="📋" FontSize="42" HorizontalAlignment="Center" Opacity="0.4"/>
                <TextBlock Text="Este paciente no tiene historial clínico registrado" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Historiales}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="8" Padding="12,8" VerticalAlignment="Top" Margin="0,0,16,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FechaRegistro, StringFormat={}{0:dd}}"
                                                       FontSize="20" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding FechaRegistro, StringFormat={}{0:MMM yyyy}}"
                                                       FontSize="10" Foreground="#FDE8E9"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Diagnostico}" FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Observaciones}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding FechaRegistro, StringFormat={}Atendido el {0:dd/MM/yyyy} a las {0:HH:mm}}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,8,0,0" FontStyle="Italic"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>