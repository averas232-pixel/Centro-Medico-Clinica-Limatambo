<Window x:Class="Centro_Medico_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Centro_Medico_UI.Views"
        Title="Clínica Limatambo - Sistema de Gestión" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="White" Padding="28,14">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/logo_limatambo.png" Height="44" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="CLÍNICA LIMATAMBO" FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Sistema de Gestión Clínica" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Cajamarca, Perú" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Franja de acento (eco del rojo del logo) -->
        <Rectangle Grid.Row="1" Fill="{StaticResource PrimaryBrush}"/>

        <!-- ===== SIDEBAR + CONTENIDO ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0">
                        <TextBlock Text="MÓDULOS" FontSize="11" FontWeight="Bold"
                                   Foreground="#8A6B6C" Margin="18,0,0,12"/>

                        <RadioButton x:Name="NavAgenda" GroupName="Nav" Style="{StaticResource BotonNav}"
                                     Checked="NavAgenda_Checked">
                            <TextBlock Text="Agenda de Citas"/>
                        </RadioButton>
                        <RadioButton x:Name="NavConsulta" GroupName="Nav" Style="{StaticResource BotonNav}"
                                     Checked="NavConsulta_Checked">
                            <TextBlock Text="Cierre de Consulta"/>
                        </RadioButton>
                        <RadioButton x:Name="NavHistorial" GroupName="Nav" Style="{StaticResource BotonNav}"
                                     Checked="NavHistorial_Checked">
                            <TextBlock Text="Historial Clínico"/>
                        </RadioButton>
                        <RadioButton x:Name="NavFacturacion" GroupName="Nav" Style="{StaticResource BotonNav}"
                                     Checked="NavFacturacion_Checked">
                            <TextBlock Text="Facturación"/>
                        </RadioButton>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock x:Name="UsuarioNombreText" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="UsuarioRolText" FontSize="11" Foreground="#B0A0A0"/>
                        </StackPanel>
                    </Border>

                    <Grid/>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" x:Name="ContenidoPrincipal"/>
        </Grid>
    </Grid>
</Window>